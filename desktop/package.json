{
  "name": "kvmflow-desktop",
  "productName": "KVMFlow",
  "version": "0.4.0-beta.2",
  "description": "KVMFlow - USB switch triggered monitor input switching",
  "author": "KVMFlow Project",
  "private": true,
  "scripts": {
    "start": "tauri dev",
    "tauri": "tauri",
    "test": "node --test tests/*.test.js",
    "pretest:rust": "node scripts/prepare-tauri.js --rust-tests",
    "test:rust": "cargo test --locked --manifest-path src-tauri/Cargo.toml",
    "smoke": "cargo test --locked --manifest-path ../sidecar/Cargo.toml -p kvmflow-sidecar --test embedded_runtime",
    "dist:mac": "node scripts/build-tauri.js mac",
    "dist:win": "node scripts/build-tauri.js win",
    "serve:lan": "node scripts/serve-downloads.js"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "jsdom": "^26.1.0"
  }
}
